---
// Komponen Footer Website Ma'had Ar-Rosyad
---

<footer class="bg-white border-t border-gray-100 pt-16 pb-8 text-gray-600 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Grid Utama Footer (4 Kolom) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-16">
      
      <!-- Kolom 1: Logo & Deskripsi (Lebar 4 kolom) -->
      <div class="md:col-span-4 space-y-4">
        <!-- Logo & Nama -->
        <div class="flex items-center gap-3">
          <img 
            src="/favicon.svg" 
            alt="Logo Ar-Rosyad" 
            class="w-10 h-10 object-contain"
          />
          <span class="font-bold text-gray-900 text-lg">Ar-Rosyad</span>
        </div>

        <!-- Deskripsi Lembaga -->
        <p class="text-gray-600 leading-relaxed text-sm">
          Ma'had Ar-Rosyad Al-Islamiy Kediri adalah lembaga pendidikan Islam berbasis Al-Qur'an dan Sunnah sesuai Manhaj Salafush Shalih.
        </p>

        <!-- Alamat -->
        <p class="text-gray-600 text-sm leading-relaxed">
          Basarudin, Jl. Masjid Basyaruddin, Bogem, Kec. Gurah, Kab. Kediri, Jatim 64181
        </p>

        <!-- Doa / Kutipan Arab -->
        <div class="pt-2">
          <p class="text-green-700 font-serif text-lg tracking-wide">
            وَقُلْ رَّبِّ زِدْنِي عِلْمًا
          </p>
        </div>
      </div>

      <!-- Kolom 2: Link Cepat (Lebar 2-3 kolom) -->
      <div class="md:col-span-2 space-y-4">
        <h4 class="font-bold text-gray-900 text-base">Link Cepat</h4>
        <ul class="space-y-2.5">
          <li><a href="#" class="hover:text-green-600 transition-colors">Beranda</a></li>
          <li><a href="#" class="hover:text-green-600 transition-colors">Profil</a></li>
          <li><a href="#" class="hover:text-green-600 transition-colors">Program Pendidikan</a></li>
          <li><a href="#" class="hover:text-green-600 transition-colors">Galeri Kegiatan</a></li>
          <li><a href="#" class="hover:text-green-600 transition-colors">PSB 2026/2027</a></li>
          <li><a href="#" class="hover:text-green-600 transition-colors">Donasi</a></li>
        </ul>
      </div>

      <!-- Kolom 3: Kontak & Sosmed (Lebar 3 kolom) -->
      <div class="md:col-span-3 space-y-4">
        <h4 class="font-bold text-gray-900 text-base">Kontak</h4>
        <div class="space-y-2">
          <p class="text-gray-600">mahadarrosyad@gmail.com</p>
          <p class="text-gray-600">Jam Operasional:</p>
        </div>

        <!-- Ikon Media Sosial Bulat -->
        <div class="flex items-center gap-3 pt-2">
          <!-- TikTok -->
          <a href="#" class="w-9 h-9 rounded-full border border-gray-200 flex items-center justify-center text-gray-700 hover:bg-green-50 hover:border-green-600 hover:text-green-600 transition-all">
