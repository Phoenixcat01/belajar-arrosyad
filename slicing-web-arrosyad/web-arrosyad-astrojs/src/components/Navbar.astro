---
// Komponen Navbar
---

<header class="w-full bg-white shadow-sm sticky top-0 z-50">
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between"
    >
        <!-- Logo & Nama Ma'had -->
        <div class="flex items-center gap-3">
            <img
                src="/images/logo-arrosyad.jpg"
                alt="Logo Ar-Rosyad"
                class="h-10 w-auto object-contain p-1 border border-gray-100 rounded-full bg-gray-50"
            />
            <span class="font-bold text-xl text-gray-900 tracking-wide"
                >Ar-Rosyad</span
            >
        </div>

        <!-- Tombol Donasi di Kanan -->
        <div>
            <a
                href="#donasi"
                class="bg-[#84cc16] hover:bg-[#65a30d] text-white font-medium px-6 py-2.5 rounded-lg transition duration-200 shadow-sm"
            >
                Donasi
            </a>
        </div>
    </div>
</header>
