---
import Layout from "../../layouts/Layout.astro";
const title = "Astro";

const { id } = Astro.params;

const response = await fetch(
    `https://jsonplaceholder.typicode.com/posts/${id}`,
);
const post = await response.json();
---

<Layout judul={title}>
    <h1>{title}</h1>

    <div>
        <p>{post.body}</p>
    </div>
</Layout>

<style>
    h1 {
        color: red;
    }
</style>
