---
import Layout from "../layouts/Layout.astro";
const title = 'Home';

const response = await fetch('https://jsonplaceholder.typicode.com/posts');
const posts = await response.json();

console.log(posts);
---

<Layout judul={title}>
	<h1>{title}</h1>

	{
	posts.map((post) => {
	return (
	<div>
		<h2>{post.title}</h2>
		<p>{post.body}</p>
		<a href={`/post/${post.id}`}>Buka</a>
	</div>
	)
	})
	}
</Layout>

<style>
	h1 {
		color: red;
	}
</style>